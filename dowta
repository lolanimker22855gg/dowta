function GB:AddToggle(flag, o)
	o = o or {}
	local obj = { Type = "Toggle", Flag = flag, Text = o.Text or flag, Value = false, Callback = o.Callback }
	local r = row(self.Body, 22)
	local lbl = text(r, obj.Text, { Size = UDim2.new(1, -70, 1, 0) })
	local right = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = r })
	list(right, "H", 5, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	if o.Key or o.Keybind then makeKeybind(right, obj, o.Key, o.Mode, 0) end
	if o.Color then
		obj.ColorPicker = makeColor(right, flag .. "_color", { Default = o.Color, Callback = o.ColorCallback }, 1)
	end
	local sw = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(28, 14), LayoutOrder = 2, Parent = right })
	corner(sw, 7)
	local knob = new("Frame", { Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(235, 238, 248), Parent = sw })
	corner(knob, 5)
	local function visual(anim)
		local props1 = { BackgroundColor3 = obj.Value and T.Accent or T.Track }
		local props2 = { Position = obj.Value and UDim2.fromOffset(16, 2) or UDim2.fromOffset(2, 2) }
		if anim then tween(sw, props1) tween(knob, props2) else sw.BackgroundColor3 = props1.BackgroundColor3 knob.Position = props2.Position end
		lbl.TextColor3 = obj.Value and T.Text or T.Dim
	end
	function obj:SetValue(v, silent)
		self.Value = v and true or false
		Library.Flags[flag] = self.Value
		visual(true)
		if not silent and self.Callback then task.spawn(self.Callback, self.Value) end
		Library:RefreshHotkeys()
	end
	sw.MouseButton1Click:Connect(function() obj:SetValue(not obj.Value) end)
	reg(function() visual(false) end)
	obj.Value = o.Default and true or false
	Library.Flags[flag] = obj.Value
	visual(false)
	Library.Options[flag] = obj
	return obj
end

function GB:AddSlider(flag, o)
	local min, max, dec, suf = o.Min or 0, o.Max or 100, o.Rounding or 0, o.Suffix or ""
	local obj = { Type = "Slider", Flag = flag, Value = o.Default or min, Callback = o.Callback }
	local r = row(self.Body, 34)
	text(r, o.Text or flag, { Size = UDim2.new(1, -60, 0, 18) })
	local right = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = r })
	list(right, "H", 4, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local chip = chipLabel(right)
	local hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 19), Parent = r })
	local track = new("Frame", { BackgroundColor3 = T.Track, Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 5), BorderSizePixel = 0, Parent = hit })
	corner(track, 2)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track })
	corner(fill, 2)
	reg(function() fill.BackgroundColor3 = T.Accent end)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(235, 238, 248), Position = UDim2.fromScale(0, 0.5), Parent = track })
	corner(knob, 5)
	function obj:SetValue(v, silent)
		v = round(math.clamp(v, min, max), dec)
		self.Value = v Library.Flags[flag] = v
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1) knob.Position = UDim2.fromScale(a, 0.5)
		chip.Text = tostring(v) .. suf
		if not silent and self.Callback then task.spawn(self.Callback, v) end
	end
	drag(hit, function(p) obj:SetValue(min + (max - min) * clamp01((p.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)) end)
	obj:SetValue(obj.Value, true)
	Library.Options[flag] = obj
	return obj
end

function GB:AddRange(flag, o)
	local min, max, dec, suf = o.Min or 0, o.Max or 100, o.Rounding or 0, o.Suffix or ""
	local d = o.Default or { min, max }
	local obj = { Type = "Range", Flag = flag, Lo = d[1], Hi = d[2], Callback = o.Callback }
	local r = row(self.Body, 34)
	text(r, o.Text or flag, { Size = UDim2.new(1, -90, 0, 18) })
	local right = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = r })
	list(right, "H", 3, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local c1, c2 = chipLabel(right, 0), chipLabel(right, 1)
	local hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 19), Parent = r })
	local track = new("Frame", { BackgroundColor3 = T.Track, Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 5), BorderSizePixel = 0, Parent = hit })
	corner(track, 2)
	local fill = new("Frame", { BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = track })
	corner(fill, 2)
	reg(function() fill.BackgroundColor3 = T.Accent end)
	local function mk()
		local k = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(235, 238, 248), Parent = track })
		corner(k, 5) return k
	end
	local k1, k2 = mk(), mk()
	function obj:SetValue(lo, hi, silent)
		lo, hi = round(math.clamp(lo, min, max), dec), round(math.clamp(hi, min, max), dec)
		if lo > hi then lo, hi = hi, lo end
		self.Lo, self.Hi = lo, hi
		Library.Flags[flag] = { lo, hi }
		local a, b = (lo - min) / (max - min), (hi - min) / (max - min)
		fill.Position = UDim2.fromScale(a, 0) fill.Size = UDim2.fromScale(b - a, 1)
		k1.Position = UDim2.fromScale(a, 0.5) k2.Position = UDim2.fromScale(b, 0.5)
		c1.Text, c2.Text = tostring(lo) .. suf, tostring(hi) .. suf
		if not silent and self.Callback then task.spawn(self.Callback, lo, hi) end
	end
	local active = 1
	drag(hit, function(p, began)
		local v = min + (max - min) * clamp01((p.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
		if began then active = math.abs(v - obj.Lo) <= math.abs(v - obj.Hi) and 1 or 2 end
		if active == 1 then obj:SetValue(math.min(v, obj.Hi), obj.Hi) else obj:SetValue(obj.Lo, math.max(v, obj.Lo)) end
	end)
	obj:SetValue(obj.Lo, obj.Hi, true)
	Library.Options[flag] = obj
	return obj
end

