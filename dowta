		tab.Content.Visible = true
		tab.Button.BackgroundTransparency = 0
		tab.Stroke.Transparency = 0
		tab.Label.TextColor3 = T.Text
		tab.Icon.TextColor3 = T.Text
		self:ClosePopup()
	end

	local order = 0
	function W:AddSection(name)
		order += 1
		new("TextLabel", { BackgroundTransparency = 1, Text = name, Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = T.Dim,
			TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = order, Parent = nav })
		pad(nav:GetChildren()[#nav:GetChildren()], 4, 0, 0, 0)
	end

	function W:AddTab(name, icon)
		order += 1
		local tab = { Name = name }
		local b = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = T.Hover, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 26), LayoutOrder = order, Parent = nav })
		corner(b, 5)
		tab.Stroke = stroke(b, T.Stroke) tab.Stroke.Transparency = 1
		tab.Icon = text(b, icon or "•", { Size = UDim2.fromOffset(20, 26), Position = UDim2.fromOffset(6, 0), TextColor3 = T.Dim, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center })
		tab.Label = text(b, name, { Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(34, 0), TextColor3 = T.Dim })
		tab.Button = b
		tab.Content = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
		tab.Columns = {}
		for i = 1, 2 do
			local c = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y, Size = UDim2.new(0, 207, 1, -16), Position = UDim2.fromOffset(8 + (i - 1) * 217, 10), Parent = tab.Content })
			list(c, "V", 8)
			tab.Columns[i] = c
		end
		function tab:AddGroupbox(title, go)
			go = go or {}
			local col = tab.Columns[go.Side or 1]
			local g = setmetatable({}, GB)
			local holder = new("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = col })
			list(holder, "V", 4)
			local head = row(holder, 22)
			head.LayoutOrder = 0
			text(head, go.Icon or "▣", { Size = UDim2.fromOffset(18, 22), TextColor3 = T.Dim, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center })
			text(head, title, { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -26, 1, 0), TextColor3 = T.Dim })
			if go.Desc then
				local d = row(holder, 14) d.LayoutOrder = 1
				text(d, go.Desc, { TextColor3 = T.Dim, TextSize = 11, Font = Enum.Font.Gotham })
			end
			local body = new("Frame", { BackgroundColor3 = T.Body, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 2, Parent = holder })
			corner(body, 6) stroke(body) pad(body, 10, 8, 10, 8) list(body, "V", 4)
			g.Body = body
			return g
		end
		b.MouseButton1Click:Connect(function() select(tab) end)
		table.insert(W.Tabs, tab)
		if not current then select(tab) end
		return tab
	end

	connect(search:GetPropertyChangedSignal("Text"), function()
		local q = search.Text:lower()
		for _, t in ipairs(W.Tabs) do t.Button.Visible = q == "" or t.Name:lower():find(q, 1, true) ~= nil end
	end)

	--// input
	if not self._init then
		self._init = true
		connect(UIS.InputBegan, function(i)
			local t = i.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
				local p = self.Popup
				if p then
					local m = UIS:GetMouseLocation()
					if not inside(p.frame, m) and not inside(p.owner, m) then self:ClosePopup() end
				end
			end
			if t ~= Enum.UserInputType.Keyboard or self.Listening or UIS:GetFocusedTextBox() then return end
			if i.KeyCode == self.ToggleKey then self:Toggle() return end
			for obj in pairs(self.Binds) do
				if obj.Key == i.KeyCode then
					if obj.Mode == "Hold" then obj:SetValue(true) else obj:SetValue(not obj.Value) end
				end
			end
		end)
		connect(UIS.InputEnded, function(i)
			if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
			for obj in pairs(self.Binds) do
				if obj.Key == i.KeyCode and obj.Mode == "Hold" then obj:SetValue(false) end
			end
		end)
		connect(RS.RenderStepped, function()
			local t = tick()
			for obj in pairs(self.Animated) do
				if obj.Anim == "Rainbow" then obj.H = (t * 0.25) % 1
				elseif obj.Anim == "Pulse" then obj.BaseV = obj.BaseV or obj.V obj.V = clamp01(obj.BaseV * (0.65 + 0.35 * math.sin(t * 3)))
				elseif obj.Anim == "Fade" then obj.A = 0.5 + 0.5 * math.sin(t * 2) end
				obj:Update()
			end
		end)
	end
	self.Window = W
	return W
end

--// config
function Library:GetConfig()
	local t = {}
	for flag, o in pairs(self.Options) do
		if o.Type == "Toggle" then t[flag] = { v = o.Value, key = o.Key and o.Key.Name, mode = o.Mode }
		elseif o.Type == "Keybind" then t[flag] = { key = o.Key and o.Key.Name, mode = o.Mode }
		elseif o.Type == "Range" then t[flag] = { o.Lo, o.Hi }
		elseif o.Type == "Color" then t[flag] = { h = o.H, s = o.S, v = o.V, a = o.A, anim = o.Anim }
		elseif o.Type == "Dropdown" then t[flag] = o.Value
		else t[flag] = o.Value end
	end
	return t
end
function Library:SetConfig(t)
	for flag, v in pairs(t) do
		local o = self.Options[flag]
		if o then
			if o.Type == "Toggle" then
				o:SetValue(v.v)
				if o.Chip then o.Key = v.key and Enum.KeyCode[v.key] or nil o.Mode = v.mode or o.Mode o.Chip.Text = keyName(o.Key) end
			elseif o.Type == "Keybind" then
				o.Key = v.key and Enum.KeyCode[v.key] or nil o.Mode = v.mode or o.Mode o.Chip.Text = keyName(o.Key)
			elseif o.Type == "Range" then o:SetValue(v[1], v[2])
			elseif o.Type == "Color" then o.H, o.S, o.V, o.A = v.h, v.s, v.v, v.a o:SetAnim(v.anim or "None") o:Update()
			else o:SetValue and o:SetValue(v) or o:Set(v) end
		end
	end
	self:RefreshHotkeys()
end
function Library:Save(name)
	if writefile then writefile("blossom_" .. name .. ".json", HttpService:JSONEncode(self:GetConfig())) end
end
function Library:Load(name)
	if readfile and isfile and isfile("blossom_" .. name .. ".json") then
		self:SetConfig(HttpService:JSONDecode(readfile("blossom_" .. name .. ".json")))
	end
end

function Library:Unload()
	for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
	if self.Gui then self.Gui:Destroy() end
	self.Binds, self.Animated = {}, {}
end

return Library
