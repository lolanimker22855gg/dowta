	local sbox = new("Frame", { BackgroundColor3 = T.Input, Size = UDim2.fromOffset(122, 28), Position = UDim2.new(0, 10, 1, -40), Parent = side })
	corner(sbox, 5) stroke(sbox)
	text(sbox, "⌕", { Size = UDim2.fromOffset(20, 28), Position = UDim2.fromOffset(6, 0), TextColor3 = T.Dim, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center })
	local search = new("TextBox", { Text = "", PlaceholderText = "Search...", PlaceholderColor3 = T.Dim, ClearTextOnFocus = false, BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
