--// helpers
local function new(class, props)
	local i = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then i[k] = v end
	end
	if props and props.Parent then i.Parent = props.Parent end
	return i
end
local function corner(i, r) local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, r) c.Parent = i return c end
local function stroke(i, col, th)
	local s = Instance.new("UIStroke") s.Color = col or T.Stroke s.Thickness = th or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border s.Parent = i return s
end
local function pad(i, l, t, r, b)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, l or 0) p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingRight = UDim.new(0, r or 0) p.PaddingBottom = UDim.new(0, b or 0) p.Parent = i return p
end
local function list(i, dir, gap, ha, va)
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap or 0)
	l.FillDirection = dir == "H" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	if ha then l.HorizontalAlignment = ha end
	if va then l.VerticalAlignment = va end
	l.Parent = i return l
end
local function text(parent, str, props)
	local t = new("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 12, Text = str,
		TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 1, 0),
	})
	for k, v in pairs(props or {}) do t[k] = v end
	t.Parent = parent
	return t
end
local function row(parent, h)
	return new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h), Parent = parent })
end
local function tween(i, props, t) TS:Create(i, TweenInfo.new(t or 0.12, Enum.EasingStyle.Quad), props):Play() end
local function connect(sig, fn) local c = sig:Connect(fn) table.insert(Library.Connections, c) return c end
local function reg(fn) fn() table.insert(Library.AccentFns, fn) end
local function inside(g, p)
	local a, s = g.AbsolutePosition, g.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end
local function clamp01(x) return math.clamp(x, 0, 1) end
local function round(v, d) local m = 10 ^ (d or 0) return math.floor(v * m + 0.5) / m end

local function drag(gui, fn)
	connect(gui.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			fn(UIS:GetMouseLocation(), true)
			local c
			c = RS.RenderStepped:Connect(function()
				if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then c:Disconnect() return end
				fn(UIS:GetMouseLocation(), false)
			end)
		end
	end)
end
local function draggable(handle, target)
	local off
	drag(handle, function(p, began)
		if began then off = target.AbsolutePosition - p end
		local np = p + off
		target.Position = UDim2.fromOffset(np.X, np.Y)
	end)
end

local KeyMap = { LeftShift = "LS", RightShift = "RS", LeftControl = "LC", RightControl = "RC", LeftAlt = "LA",
	RightAlt = "RA", Insert = "INS", Delete = "DEL", Return = "ENT", Space = "SPC", One = "1", Two = "2", Three = "3",
	Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0", Backquote = "`" }
local function keyName(k)
	if not k then return "-" end
	return KeyMap[k.Name] or (#k.Name > 4 and k.Name:sub(1, 4) or k.Name)
end

--// popups
function Library:ClosePopup()
	local p = self.Popup
	if p then
		self.Popup = nil
		p.frame:Destroy()
		if p.onClose then p.onClose() end
	end
end
function Library:OpenPopup(frame, owner, onClose, x, y)
	self:ClosePopup()
	local o = self.Overlay
	local s = frame.AbsoluteSize
	frame.Size = frame.Size
	frame.Parent = o
	local sz = frame.Size
	local w, h = sz.X.Offset, sz.Y.Offset
	local os = o.AbsoluteSize
	frame.Position = UDim2.fromOffset(math.clamp(x, 0, math.max(0, os.X - w)), math.clamp(y, 0, math.max(0, os.Y - h)))
	self.Popup = { frame = frame, owner = owner, onClose = onClose }
end

--// hotkeys list / watermark / notify
function Library:RefreshHotkeys()
	local hk = self.HotkeyList
	if not hk then return end
	for _, c in ipairs(hk.Entries:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local arr = {}
	for obj in pairs(self.Binds) do
		if obj.Value and obj.Key and obj.ShowInList ~= false then arr[#arr + 1] = obj end
	end
	table.sort(arr, function(a, b) return a.Text < b.Text end)
	for n, obj in ipairs(arr) do
		local f = new("Frame", { BackgroundColor3 = T.Window, AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 24), LayoutOrder = n, Parent = hk.Entries })
		corner(f, 6) stroke(f) pad(f, 9, 0, 9, 0)
		local bar = new("Frame", { Size = UDim2.fromOffset(2, 12), Position = UDim2.new(0, -6, 0.5, -6), BorderSizePixel = 0, Parent = f })
		reg(function() bar.BackgroundColor3 = T.Accent end)
		text(f, obj.Text .. " - " .. keyName(obj.Key), { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 24), Font = Enum.Font.GothamBold })
	end
end

function Library:SetWatermark(parts)
	if self.WatermarkFrame then self.WatermarkFrame:Destroy() end
	local f = new("Frame", { BackgroundColor3 = T.Window, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 28),
		Position = UDim2.fromOffset(10, 10), Parent = self.Gui })
	corner(f, 6) stroke(f) pad(f, 10, 0, 10, 0)
	list(f, "H", 8, nil, Enum.VerticalAlignment.Center)
	for i, p in ipairs(parts) do
		if i > 1 then new("Frame", { Size = UDim2.fromOffset(1, 12), BackgroundColor3 = T.Stroke, BorderSizePixel = 0, LayoutOrder = i * 2 - 1, Parent = f }) end
		local icon, str = nil, p
		if type(p) == "table" then icon, str = p.Icon, p.Text end
		local c = T.Accent
		local lbl = text(f, "", { RichText = true, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), LayoutOrder = i * 2, Font = Enum.Font.GothamBold })
		reg(function()
			local col = string.format("rgb(%d,%d,%d)", T.Accent.R * 255, T.Accent.G * 255, T.Accent.B * 255)
			lbl.Text = (icon and ('<font color="' .. col .. '">' .. icon .. '</font> ') or "") .. str
		end)
	end
	draggable(f, f)
	self.WatermarkFrame = f
	return f
end
function Library:SetWatermarkVisible(b) if self.WatermarkFrame then self.WatermarkFrame.Visible = b end end
function Library:SetHotkeysVisible(b) if self.HotkeyList then self.HotkeyList.Frame.Visible = b end end

function Library:Notify(msg, dur)
	local f = new("Frame", { BackgroundColor3 = T.Window, Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Parent = self.NotifyHolder })
	corner(f, 6) stroke(f) pad(f, 14, 0, 12, 0)
	local bar = new("Frame", { Size = UDim2.fromOffset(2, 14), Position = UDim2.new(0, -8, 0.5, -7), BorderSizePixel = 0, Parent = f })
	reg(function() bar.BackgroundColor3 = T.Accent end)
	text(f, msg, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28) })
	task.delay(dur or 3, function() f:Destroy() end)
end

function Library:SetAccent(c)
	T.Accent = c
	for _, fn in ipairs(self.AccentFns) do pcall(fn) end
end
function Library:Toggle(b)
	if b == nil then b = not self.Main.Visible end
	self.Main.Visible = b
	if not b then self:ClosePopup() end
end

--// keybind core
local function modePanel(obj, chip)
	local f = new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(190, 78) })
	corner(f, 6) stroke(f) pad(f, 6, 6, 6, 6)
	local btns = {}
	local function refresh()
		for m, b in pairs(btns) do
			b.BackgroundColor3 = obj.Mode == m and T.Accent or T.Input
		end
	end
	for i, m in ipairs({ "Toggle", "Hold" }) do
		local b = new("TextButton", { Text = m == "Toggle" and "On Toggle" or "On Hold", Font = Enum.Font.GothamBold, TextSize = 12,
			TextColor3 = T.Text, AutoButtonColor = false, Size = UDim2.fromOffset(86, 26), Position = UDim2.fromOffset((i - 1) * 90, 0), Parent = f })
		corner(b, 4) btns[m] = b
		b.MouseButton1Click:Connect(function() obj.Mode = m refresh() end)
	end
	local r = new("TextButton", { Text = "↻  Reset", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Text, AutoButtonColor = false,
		BackgroundColor3 = T.Input, Size = UDim2.fromOffset(178, 26), Position = UDim2.fromOffset(0, 34), Parent = f })
	corner(r, 4) stroke(r)
	r.MouseButton1Click:Connect(function()
		obj.Key = obj.DefaultKey obj.Mode = obj.DefaultMode or "Toggle"
		chip.Text = keyName(obj.Key) refresh() Library:RefreshHotkeys()
	end)
	refresh()
	local p = chip.AbsolutePosition
	Library:OpenPopup(f, chip, nil, p.X - 160, p.Y + 22)
end

local function makeKeybind(parent, obj, key, mode, order)
	obj.Key, obj.DefaultKey = key, key
	obj.Mode, obj.DefaultMode = mode or "Toggle", mode or "Toggle"
	local chip = new("TextButton", { Text = keyName(key), Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = T.Dim,
		BackgroundColor3 = T.Chip, AutoButtonColor = false, Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = order or 0, Parent = parent })
	corner(chip, 3) pad(chip, 5, 0, 5, 0) stroke(chip)
	local listening = false
	chip.MouseButton1Click:Connect(function()
		listening = true Library.Listening = true chip.Text = "..."
	end)
	chip.MouseButton2Click:Connect(function() modePanel(obj, chip) end)
	connect(UIS.InputBegan, function(i)
		if listening and i.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			task.defer(function() Library.Listening = false end)
			if i.KeyCode == Enum.KeyCode.Escape or i.KeyCode == Enum.KeyCode.Backspace then obj.Key = nil else obj.Key = i.KeyCode end
			chip.Text = keyName(obj.Key)
			Library:RefreshHotkeys()
		end
	end)
	obj.Chip = chip
	Library.Binds[obj] = true
end

--// dropdown box
local function dropdownBox(parent, o)
	local d = { Items = o.Items, Multi = o.Multi, Callback = o.Callback }
	local box = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = T.Input,
		Size = o.Size or UDim2.new(1, 0, 0, 24), Position = o.Position or UDim2.new(), LayoutOrder = o.Order or 0, Parent = parent })
	corner(box, 4) stroke(box)
	local txt = text(box, "", { Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(8, 0), TextColor3 = T.Dim, TextTruncate = Enum.TextTruncate.AtEnd })
	text(box, "▦", { Size = UDim2.fromOffset(20, 24), Position = UDim2.new(1, -22, 0, 0), TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Center })
	d.Box = box
	d.Value = o.Multi and {} or o.Default
	local function show()
		if d.Multi then
			local t = {}
			for _, it in ipairs(d.Items) do if d.Value[it] then t[#t + 1] = it end end
			txt.Text = #t > 0 and table.concat(t, ", ") or "None"
		else
			txt.Text = tostring(d.Value)
		end
	end
	function d:Set(v, silent)
		if self.Multi then
			self.Value = {}
			for k, x in pairs(v or {}) do
				if type(k) == "number" then self.Value[x] = true else self.Value[k] = x and true or nil end
			end
		else
			self.Value = v
		end
		show()
		if not silent and self.Callback then task.spawn(self.Callback, self.Value) end
	end
	function d:Get() return self.Value end
	if o.Multi and o.Default then d:Set(o.Default, true) end
	show()

	local inlineList
	local function closeList()
		if inlineList then inlineList:Destroy() inlineList = nil end
		if Library.Popup and Library.Popup.owner == box then Library:ClosePopup() end
	end
	box.MouseButton1Click:Connect(function()
		if inlineList or (Library.Popup and Library.Popup.owner == box) then closeList() return end
		local h = #d.Items * 22 + 4
		local lf = new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(box.AbsoluteSize.X, h) })
		corner(lf, 4) stroke(lf) pad(lf, 0, 2, 0, 2) list(lf, "V", 0)
		local function render()
			for _, c in ipairs(lf:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			for n, it in ipairs(d.Items) do
				local sel = d.Multi and d.Value[it] or (not d.Multi and d.Value == it)
				local b = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = T.Hover,
					BackgroundTransparency = sel and 0.4 or 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = n, Parent = lf })
				text(b, it, { Position = UDim2.fromOffset(sel and 14 or 10, 0), Size = UDim2.new(1, -16, 1, 0), TextColor3 = sel and T.Text or T.Dim })
				if sel then
					local bar = new("Frame", { Size = UDim2.fromOffset(2, 12), Position = UDim2.new(0, 3, 0.5, -6), BorderSizePixel = 0, Parent = b })
					reg(function() bar.BackgroundColor3 = T.Accent end)
				end
				b.MouseButton1Click:Connect(function()
					if d.Multi then
						d.Value[it] = not d.Value[it] or nil
						d:Set(d.Value) render()
					else
						d:Set(it) closeList()
					end
				end)
			end
		end
		render()
		if o.Inline then
			local ap, ip = box.AbsolutePosition, o.Inline.AbsolutePosition
			lf.Position = UDim2.fromOffset(ap.X - ip.X, ap.Y - ip.Y - h - 2)
			lf.ZIndex = 20 lf.Parent = o.Inline
			inlineList = lf
		else
			local p = box.AbsolutePosition
			Library:OpenPopup(lf, box, nil, p.X, p.Y + box.AbsoluteSize.Y + 2)
		end
	end)
	return d
end

--// color picker
local function makeColor(parent, flag, o, order)
	local obj = { Type = "Color", Flag = flag, H = 0, S = 0, V = 1, A = 1, Anim = "None", Callback = o.Callback, Value = Color3.new(1, 1, 1) }
	local sw = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(12, 12), LayoutOrder = order or 1, Parent = parent })
	corner(sw, 3) stroke(sw)
	function obj:Update(silent)
		self.Value = Color3.fromHSV(self.H, self.S, self.V)
		sw.BackgroundColor3 = self.Value
		Library.Flags[flag] = self.Value
		if self.Refresh then self.Refresh() end
		if not silent and self.Callback then task.spawn(self.Callback, self.Value, self.A) end
	end
	function obj:SetValue(c, a) self.H, self.S, self.V = c:ToHSV() if a then self.A = a end self:Update() end
	function obj:SetAnim(a)
		self.Anim = a
		Library.Animated[self] = a ~= "None" and true or nil
		if a == "None" then self.BaseV = nil end
	end
	if o.Default then obj.H, obj.S, obj.V = o.Default:ToHSV() end
	if o.Alpha then obj.A = o.Alpha end
	obj:Update(true)

	sw.MouseButton1Click:Connect(function()
		if Library.Popup and Library.Popup.owner == sw then Library:ClosePopup() return end
		local f = new("Frame", { BackgroundColor3 = T.Panel, Size = UDim2.fromOffset(205, 258) })
		corner(f, 6) stroke(f)
		local sv = new("Frame", { Position = UDim2.fromOffset(11, 11), Size = UDim2.fromOffset(172, 168), BorderSizePixel = 0, Parent = f })
		corner(sv, 4)
		local white = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sv })
		corner(white, 4)
		new("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
		local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sv })
		corner(black, 4)
		new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
		local svc = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, Parent = sv, ZIndex = 5 })
		corner(svc, 5) stroke(svc, Color3.new(1, 1, 1), 2)

		local hue = new("Frame", { Position = UDim2.fromOffset(186, 11), Size = UDim2.fromOffset(11, 168), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = f })
		corner(hue, 3)
		local seq = {}
		for i = 0, 6 do seq[#seq + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)) end
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(seq), Parent = hue })
		local huec = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(11, 11), BackgroundColor3 = Color3.new(1, 1, 1), Parent = hue, ZIndex = 5 })
		corner(huec, 6)
		local hs = stroke(huec, T.Accent, 2)
		reg(function() hs.Color = T.Accent end)

		local alpha = new("Frame", { Position = UDim2.fromOffset(11, 186), Size = UDim2.fromOffset(186, 10), BackgroundColor3 = Color3.fromRGB(210, 210, 215), BorderSizePixel = 0, Parent = f })
		corner(alpha, 5)
		local chk = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(150, 150, 160), BackgroundTransparency = 0.5, BorderSizePixel = 0, Parent = alpha })
		corner(chk, 5)
		local af = new("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Parent = alpha })
		corner(af, 5)
		new("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = af })
		local ac = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(11, 11), BackgroundColor3 = Color3.new(1, 1, 1), Parent = alpha, ZIndex = 5 })
		corner(ac, 6)
		local as = stroke(ac, T.Accent, 2)
		reg(function() as.Color = T.Accent end)

		text(f, "Animations", { Position = UDim2.fromOffset(11, 203), Size = UDim2.fromOffset(150, 16), Font = Enum.Font.GothamBold })
		dropdownBox(f, { Items = { "None", "Rainbow", "Pulse", "Fade" }, Default = obj.Anim, Position = UDim2.fromOffset(11, 224),
			Size = UDim2.fromOffset(186, 24), Inline = f, Callback = function(v) obj:SetAnim(v) end })

		obj.Refresh = function()
			sv.BackgroundColor3 = Color3.fromHSV(obj.H, 1, 1)
			svc.Position = UDim2.fromScale(obj.S, 1 - obj.V)
			huec.Position = UDim2.new(0.5, 0, obj.H, 0)
			af.BackgroundColor3 = obj.Value
			ac.Position = UDim2.new(1 - obj.A, 0, 0.5, 0)
		end
		obj.Refresh()
		drag(sv, function(p)
			obj.S = clamp01((p.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X)
			obj.V = 1 - clamp01((p.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y)
			obj:Update()
		end)
		drag(hue, function(p)
			obj.H = clamp01((p.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y)
			obj:Update()
		end)
		drag(alpha, function(p)
			obj.A = 1 - clamp01((p.X - alpha.AbsolutePosition.X) / alpha.AbsoluteSize.X)
			obj:Update()
		end)
		local ap = sw.AbsolutePosition
		Library:OpenPopup(f, sw, function() obj.Refresh = nil end, ap.X + 18, ap.Y - 4)
	end)
	Library.Options[flag] = obj
	return obj
end

